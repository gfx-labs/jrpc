            {{end -}}
        }
    {{- else if not (eq (len .AllOf) 0) -}}
        struct{
            {{range $idx, $v := .AllOf -}}
                Field{{$idx}} {{template "schemaType" $v}}
            {{end -}}
        }
    {{- else if not (eq (len .Enum) 0) -}}
        string
    {{- else -}}
        {{goType .Type}}
    {{- end}}
{{- end -}}

type GoOpenRPCService interface {
